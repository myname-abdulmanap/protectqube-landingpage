<script>
  // Wait for Astro page transitions
  function initializeGallery() {
    // Intersection Observer for animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate');
            // Stagger animation for gallery items
            if (entry.target.classList.contains('product-gallery')) {
              const items = entry.target.querySelectorAll('.gallery-item');
              items.forEach((item, index) => {
                setTimeout(() => {
                  item.classList.add('animate');
                }, index * 150);
              });
            }
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    // Observe elements
    document.querySelectorAll('.animate-element').forEach((element) => {
      observer.observe(element);
    });

    // Gallery interactions
    const galleryItems = document.querySelectorAll('.gallery-item');

    galleryItems.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        item.classList.add('gallery-hover');
        // Add photography-style focus effect
        galleryItems.forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.classList.add('gallery-blur');
          }
        });
      });

      item.addEventListener('mouseleave', () => {
        item.classList.remove('gallery-hover');
        galleryItems.forEach((otherItem) => {
          otherItem.classList.remove('gallery-blur');
        });
      });
    });

    // Photography-style loading effect
    const images = document.querySelectorAll('.gallery-image');
    images.forEach((img) => {
      if (img.complete) {
        img.parentElement.classList.add('image-loaded');
      } else {
        img.addEventListener('load', () => {
          img.parentElement.classList.add('image-loaded');
        });
      }
    });

    // Lightbox functionality
    initializeLightbox();
  }

  // Lightbox System
  function initializeLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.querySelector('.lightbox-title');
    const lightboxClose = document.querySelector('.lightbox-close');
    const lightboxOverlay = document.querySelector('.lightbox-overlay');
    const prevBtn = document.querySelector('.lightbox-prev');
    const nextBtn = document.querySelector('.lightbox-next');

    const images = Array.from(document.querySelectorAll('[data-lightbox="product-gallery"]'));
    let currentIndex = 0;

    // Open lightbox
    function openLightbox(index) {
      currentIndex = index;
      const img = images[currentIndex];
      lightboxImage.src = img.src;
      lightboxImage.alt = img.alt;
      lightboxTitle.textContent = img.dataset.title || img.alt;

      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';

      // Update navigation buttons
      prevBtn.style.display = images.length > 1 ? 'block' : 'none';
      nextBtn.style.display = images.length > 1 ? 'block' : 'none';
    }

    // Close lightbox
    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    // Navigate images
    function showImage(index) {
      if (index < 0) index = images.length - 1;
      if (index >= images.length) index = 0;
      openLightbox(index);
    }

    // Event listeners for images
    images.forEach((img, index) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openLightbox(index);
      });
    });

    // Close lightbox events
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxOverlay?.addEventListener('click', closeLightbox);

    // Navigation events
    prevBtn?.addEventListener('click', () => showImage(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showImage(currentIndex + 1));

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;

      switch (e.key) {
        case 'Escape':
          closeLightbox();
          break;
        case 'ArrowLeft':
          showImage(currentIndex - 1);
          break;
        case 'ArrowRight':
          showImage(currentIndex + 1);
          break;
      }
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initializeGallery);

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:page-load', initializeGallery);

  // Cleanup before page navigation
  document.addEventListener('astro:before-preparation', () => {
    const lightbox = document.getElementById('lightbox');
    if (lightbox?.classList.contains('active')) {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }
  });
</script>

<style>
  .product-showcase {
    padding: 7rem 0;
    background: var(--bg-color, #f8fafc);
    overflow: hidden;
    position: relative;
  }

  .product-showcase::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 20%, rgba(249, 115, 22, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(234, 88, 12, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .product-grid {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    align-items: center;
    text-align: center;
  }

  .excellence-section {
    position: relative;
    z-index: 2;
  }

  .excellence-section h2 {
    font-size: 2.8rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-color, #111827);
    line-height: 1.2;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .excellence-section p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary, #4b5563);
    margin-bottom: 1.5rem;
  }

  .cta-button {
    display: inline-block;
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    color: white;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: 0.75rem;
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: 0.05em;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 15px -3px rgba(249, 115, 22, 0.2);
    position: relative;
    margin-top: 1rem;
    border: none;
    cursor: pointer;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(249, 115, 22, 0.3);
  }

  /* Photography-style Gallery */
  .product-gallery {
    position: relative;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto 2rem;
  }

  .gallery-item {
    position: relative;
    border-radius: 1rem;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(20px);
    background: var(--card-bg, #f1f5f9);
  }

  .gallery-item.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .image-container {
    position: relative;
    width: 100%;
    height: 300px;
    background: var(--card-bg, #f1f5f9);
    transition: all 0.3s ease;
    border-radius: 1rem;
    overflow: hidden;
  }

  .image-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 0%, rgba(0, 0, 0, 0.02) 100%);
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .image-loaded::before {
    opacity: 0;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    filter: brightness(0.98) contrast(1.05) saturate(1.1);
    padding: 1rem;
    box-sizing: border-box;
  }

  .image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    color: white;
    padding: 2rem 1.5rem 1.5rem;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 0 0 1rem 1rem;
  }

  .overlay-content h3 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    letter-spacing: 0.025em;
    color: white;
  }

  .overlay-content p {
    font-size: 1rem;
    opacity: 0.9;
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Photography-style hover effects */
  .gallery-hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 40px -10px rgba(249, 115, 22, 0.25);
  }

  .gallery-hover .gallery-image {
    transform: scale(1.05);
    filter: brightness(1.15) contrast(1.3) saturate(1.2);
  }

  .gallery-hover .image-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .gallery-blur {
    opacity: 0.6;
    filter: blur(2px);
  }

  /* Gallery Info Panel */
  .gallery-info {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .info-stats {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .stat-item {
    text-align: center;
    flex: 1;
  }

  .stat-number {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #f97316;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #64748b;
    font-weight: 500;
  }

  /* Lightbox Styles */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
  }

  .lightbox-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 2rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    z-index: 1001;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .lightbox-image-container {
    max-width: 90%;
    max-height: 90%;
    text-align: center;
  }

  #lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .lightbox-title {
    margin-top: 1rem;
    color: white;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 0 2rem;
    pointer-events: none;
  }

  .lightbox-prev,
  .lightbox-next {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 2rem;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    pointer-events: all;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  /* Animation Classes */
  .animate-element {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }

  .animate-element.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .fade-up {
    transform: translateY(50px);
  }

  .fade-in-left {
    transform: translateX(50px);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      max-width: 800px;
    }
  }

  @media (max-width: 768px) {
    .product-showcase {
      padding: 5rem 0;
    }

    .excellence-section h2 {
      font-size: 2.2rem;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }

    .info-stats {
      flex-direction: column;
      gap: 0.75rem;
    }

    .stat-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }

    .lightbox-content {
      padding: 1rem;
    }

    .lightbox-nav {
      padding: 0 1rem;
    }

    .lightbox-prev,
    .lightbox-next {
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .excellence-section h2 {
      font-size: 1.8rem;
    }

    .cta-button {
      width: 100%;
      text-align: center;
    }

    .lightbox-close {
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }
  }
</style>
