---
import ThemeToggle from './ThemeToggle.astro';
---

<style>
  header {
    position: fixed;
    width: 100%;
    z-index: 1000;
    transition: all 0.5s ease;
  }

  header.transparent {
    background: transparent;
    box-shadow: none;
  }

  header.white {
    background: var(--bg-color);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
  }

  .nav-container {
    max-width: 100%;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* ==== LOGO ==== */
  .logo a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: auto;
    position: relative;
  }

  .logo-img {
    display: block;
    max-width: 230px;
    height: auto;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .logo-white {
    position: absolute;
    opacity: 0;
  }

  header.transparent .logo-white {
    opacity: 1;
  }

  header.transparent .logo-dark {
    opacity: 0;
  }

  /* ==== MENU ==== */
  .menu {
    display: flex;
    align-items: center;
  }

  .menu ul {
    display: flex;
    gap: 2.5rem;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu a {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 600;
    transition: all 0.3s ease;
    font-size: 1.05rem;
    position: relative;
    padding: 0.5rem 0;
  }

  .menu a:not(.try-button):hover {
    color: var(--primary-color);
    transform: translateY(-1px);
  }

  .menu a:not(.try-button)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--primary-color);
    transition: width 0.3s ease;
  }

  .menu a:not(.try-button):hover::after {
    width: 100%;
  }

  header.white .menu a {
    color: var(--text-bar);
  }

  header.white .menu a:not(.try-button):hover {
    color: var(--primary-color);
  }

  /* ==== BUTTON ==== */
  .try-button {
    background: var(--bg-color);
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
    padding: 0.75rem 1.5rem;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
  }

  .mobile-try-button {
    display: none;
  }

  .try-button:hover {
    background: var(--primary-color);
    color: var(--bg-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  header.transparent .try-button {
    background: rgba(255, 255, 255, 0.15);
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
    backdrop-filter: blur(8px);
  }

  header.transparent .try-button:hover {
    background: var(--primary-color);
    color: #fff;
    border-color: var(--primary-color);
  }

  /* ==== ICONS ==== */
  .navbar-icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bar {
    display: block;
    width: 26px;
    height: 3px;
    margin: 5px 0;
    background-color: var(--text-bar);
    transition: 0.3s;
  }

  header.transparent .bar {
    background-color: #fff;
  }

  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1001;
    padding: 10px;
  }

  /* ==== OVERLAY ==== */
  .overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
  }

  .overlay.active {
    display: block;
  }

  /* ==== DROPDOWN ==== */
  .has-dropdown {
    position: relative;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: var(--bg-color);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  .has-dropdown.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown a {
    padding: 0.75rem 1.5rem;
    display: block;
    color: var(--text-color);
    font-size: 1rem;
  }

  .dropdown a:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  /* ==== RESPONSIVE ==== */
  @media (max-width: 1024px) {
    .logo-img {
      max-width: 180px;
    }
  }

  @media (max-width: 768px) {
    .hamburger {
      display: block;
    }

    .menu {
      position: fixed;
      top: 0;
      left: -280px;
      height: 100vh;
      width: 260px;
      background: var(--bg-color);
      padding: 2rem;
      transition: left 0.3s ease;
      z-index: 1000;
      overflow-y: auto;
    }

    .menu.active {
      left: 0;
    }

    .menu ul {
      flex-direction: column;
      gap: 1.5rem;
      align-items: flex-start;
      width: 100%;
    }

    .try-button {
      display: none;
    }

    .mobile-try-button {
      display: block;
      margin-top: 1.5rem;
      padding: 0.75rem 1.25rem;
      border-radius: 20px;
      background: var(--primary-color);
      color: white;
      font-weight: 600;
      text-align: center;
    }

    .logo-img {
      max-width: 160px;
    }
  }

  @media (max-width: 480px) {
    .nav-container {
      padding: 0.75rem 1rem;
    }

    .logo-img {
      max-width: 130px;
    }
  }
</style>

<div class="overlay"></div>
<header class="transparent">
  <div class="nav-container">
    <div class="logo">
      <a href="/">
        <img
          class="logo-img logo-dark"
          src="/assets/img/logo-protectcube.png"
          alt="Logo"
          width="150"
          height="150"
        />
        <img
          class="logo-img logo-white"
          src="/assets/img/logo-protectcube.png"
          alt="Logo"
          width="150"
          height="150"
        />
      </a>
    </div>

    <nav class="menu">
      <ul>
        <li><a href="/#">Home</a></li>
        <li><a href="/about">About Us</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/contact">Contact Us</a></li>
      </ul>
      <a href="/contact" class="mobile-try-button">Try for Free</a>
    </nav>

    <div class="navbar-icons">
      <a href="/contact" class="try-button">Try for Free</a>
      <ThemeToggle />
      <button class="hamburger" aria-label="Menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<script src="/src/components/js/header.ts"></script>
