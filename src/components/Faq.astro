---
// FAQ.astro - ProtectQube IOT Security FAQ Section Component
---

<section class="faq">
  <div class="faq-container" id="faq">
    <div class="faq-header">
      <h2 class="section-title fade-in">Frequently Asked Questions</h2>
      <p class="section-subtitle fade-in delay-1">
        Get answers to common questions about protectQube IOT Security Solutions
      </p>
    </div>

    <div class="faq-content">
      <div class="faq-item fade-in delay-2">
        <button class="faq-question" aria-expanded="false">
          <span>What is protectQube and how does it secure IoT devices?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              protectQube is a comprehensive IoT security platform that provides real-time threat
              detection, device monitoring, and network protection for connected devices. Our system
              uses advanced AI algorithms to identify anomalies, prevent cyber attacks, and ensure
              your IoT ecosystem remains secure with features including device authentication,
              encrypted communications, and vulnerability scanning.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-3">
        <button class="faq-question" aria-expanded="false">
          <span>Can protectQube protect both consumer and enterprise IoT devices?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              Yes, protectQube is designed to secure IoT devices across all environments. Whether
              you're protecting smart home devices, industrial sensors, medical equipment, or
              enterprise IoT infrastructure, our platform scales from protecting a few devices to
              thousands of connected endpoints with customizable security policies and monitoring
              capabilities.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-4">
        <button class="faq-question" aria-expanded="false">
          <span>How does protectQube's real-time threat detection work?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              protectQube uses machine learning and behavioral analysis to monitor network traffic,
              device communications, and system behaviors in real-time. When anomalies are detected
              - such as unauthorized access attempts, suspicious data transfers, or malware
              signatures - the system immediately alerts administrators and can automatically
              isolate compromised devices to prevent lateral movement of threats.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-5">
        <button class="faq-question" aria-expanded="false">
          <span>Is my IoT data secure with protectQube?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              Data security is fundamental to ProtectQube. We implement end-to-end encryption
              (AES-256), zero-trust architecture, secure cloud infrastructure with SOC 2 Type II
              compliance, and regular security audits. All IoT data is encrypted both in transit and
              at rest, with strict access controls and compliance with international data protection
              regulations including GDPR.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-6">
        <button class="faq-question" aria-expanded="false">
          <span>How long does protectQube deployment take?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              ProtectQube deployment typically takes 1-3 weeks depending on network complexity and
              device count. The process includes: network assessment (1-2 days), security gateway
              installation (2-3 days), device discovery and profiling (3-5 days), policy
              configuration (1-2 days), and team training (2-3 days). Our security experts provide
              full support throughout the deployment process.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-7">
        <button class="faq-question" aria-expanded="false">
          <span>Can protectQube integrate with existing security infrastructure?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              Yes, ProtectQube seamlessly integrates with existing security ecosystems including
              SIEM platforms, firewalls, network monitoring tools, and security orchestration
              systems. We support standard APIs and protocols like SYSLOG, SNMP, and REST APIs, plus
              pre-built connectors for popular security tools like Splunk, IBM QRadar, and Microsoft
              Sentinel.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-8">
        <button class="faq-question" aria-expanded="false">
          <span>What is protectQube's pricing model?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              protectQube offers flexible pricing based on the number of protected devices and
              security features required. We provide tiered plans for different use cases - from
              home users to enterprise deployments. Contact our sales team for detailed pricing
              information and custom enterprise packages. Start with our free trial to evaluate the
              platform before making any commitment.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-9">
        <button class="faq-question" aria-expanded="false">
          <span>What support and training does protectQube provide?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              ProtectQube provides 24/7 security operations center (SOC) support with expert
              cybersecurity analysts. We offer comprehensive training programs, detailed
              documentation, video tutorials, and regular security briefings. Enterprise customers
              receive dedicated security consultants, incident response support, and access to our
              threat intelligence feeds and security community.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-10">
        <button class="faq-question" aria-expanded="false">
          <span>Can I try protectQube before purchasing?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              Absolutely! We offer a 14-day free trial with full access to all security features and
              monitoring capabilities. No credit card required to start. Our security experts will
              provide a personalized demo, conduct a free IoT security assessment, and assist with
              initial setup. After the trial, choose the plan that best fits your security needs.
            </p>
          </div>
        </div>
      </div>

      <div class="faq-item fade-in delay-11">
        <button class="faq-question" aria-expanded="false">
          <span>Does protectQube support compliance requirements?</span>
          <svg
            class="faq-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="6,9 12,15 18,9"></polyline>
          </svg>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-content">
            <p>
              Yes, ProtectQube helps organizations meet various compliance requirements including
              GDPR, HIPAA, ISO 27001, NIST Cybersecurity Framework, and industry-specific
              regulations. Our platform provides automated compliance reporting, audit trails, risk
              assessments, and documentation to support your compliance efforts across different
              regulatory frameworks.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="bottom-cta">
      <h3>Ready to Secure Your IoT Infrastructure?</h3>
      <p>
        Join thousands of organizations already using ProtectQube to protect their connected devices
        and networks.
      </p>
      <div class="cta-buttons">
        <a href="/#features" class="btn-secondary">
          <span>View Security Features</span>
        </a>

        <a href="/contact" class="btn-primary">
          <span>Start Free Trial</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </div>

  <div class="faq-bg-elements">
    <div class="faq-blob faq-blob-1"></div>
    <div class="faq-blob faq-blob-2"></div>
    <div class="faq-grid-overlay"></div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg-color);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .faq-container {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text-color);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--text-light);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .faq-content {
    margin-bottom: 4rem;
  }

  .faq-item {
    background: var(--color-card);
    border-radius: var(--border-radius);
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    transition: var(--transition);
  }

  .faq-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .faq-question {
    width: 100%;
    padding: 1.5rem 2rem;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-color);
    font-size: 1.1rem;
    font-weight: 600;
    transition: var(--transition);
  }

  .faq-question:hover {
    color: var(--primary-color);
  }

  .faq-question span {
    flex: 1;
    margin-right: 1rem;
  }

  .faq-icon {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    color: var(--primary-color);
    flex-shrink: 0;
  }

  .faq-question[aria-expanded='true'] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-answer.active {
    max-height: 500px;
  }

  .faq-answer-content {
    padding: 0 2rem 1.5rem 2rem;
    color: var(--text-light);
    line-height: 1.7;
    font-size: 1rem;
  }

  .faq-answer-content p {
    margin: 0;
  }

  /* Bottom CTA */
  .bottom-cta {
    text-align: center;
    padding: 60px 40px;
    background: linear-gradient(135deg, rgba(220, 38, 127, 0.05), rgba(59, 130, 246, 0.05));
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bottom-cta h3 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--heading-color);
    margin-bottom: 16px;
  }

  .bottom-cta p {
    font-size: 1.1rem;
    color: var(--text-light);
    margin-bottom: 32px;
    opacity: 0.9;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .btn-secondary,
  .btn-primary {
    padding: 16px 32px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    text-transform: none;
    text-decoration: none;
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-color);
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    color: white;
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(220, 38, 127, 0.3);
  }

  .btn-arrow {
    transition: transform 0.3s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Background Elements */
  .faq-bg-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .faq-blob {
    position: absolute;
    background: linear-gradient(135deg, rgba(220, 38, 127, 0.08), rgba(59, 130, 246, 0.05));
    border-radius: 50%;
    filter: blur(80px);
  }

  .faq-blob-1 {
    width: 400px;
    height: 400px;
    top: 10%;
    right: -100px;
    opacity: 0.3;
    animation: float 8s ease-in-out infinite;
  }

  .faq-blob-2 {
    width: 300px;
    height: 300px;
    bottom: 20%;
    left: -50px;
    opacity: 0.2;
    animation: float 10s ease-in-out infinite reverse;
  }

  .faq-grid-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(to right, rgba(220, 38, 127, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(220, 38, 127, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridShift 25s linear infinite;
  }

  /* Animations */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes gridShift {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(50px, 50px);
    }
  }

  /* Fade-in animations */
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 0.7s ease forwards;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .delay-1 {
    animation-delay: 0.1s;
  }
  .delay-2 {
    animation-delay: 0.2s;
  }
  .delay-3 {
    animation-delay: 0.3s;
  }
  .delay-4 {
    animation-delay: 0.4s;
  }
  .delay-5 {
    animation-delay: 0.5s;
  }
  .delay-6 {
    animation-delay: 0.6s;
  }
  .delay-7 {
    animation-delay: 0.7s;
  }
  .delay-8 {
    animation-delay: 0.8s;
  }
  .delay-9 {
    animation-delay: 0.9s;
  }
  .delay-10 {
    animation-delay: 1s;
  }
  .delay-11 {
    animation-delay: 1.1s;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .faq {
      padding: 4rem 1.5rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .section-subtitle {
      font-size: 1rem;
    }

    .faq-question {
      padding: 1.25rem 1.5rem;
      font-size: 1rem;
    }

    .faq-answer-content {
      padding: 0 1.5rem 1.25rem 1.5rem;
      font-size: 0.95rem;
    }

    .bottom-cta {
      padding: 40px 24px;
    }

    .bottom-cta h3 {
      font-size: 1.5rem;
    }

    .bottom-cta p {
      font-size: 1rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .faq-question {
      padding: 1rem 1.25rem;
    }

    .faq-answer-content {
      padding: 0 1.25rem 1rem 1.25rem;
    }

    .section-title {
      font-size: 1.75rem;
    }

    .bottom-cta {
      padding: 32px 20px;
    }
  }
</style>

<script>
  // FAQ Accordion Functionality dengan View Transitions Support
  function initFAQ() {
    const faqQuestions = document.querySelectorAll('.faq-question');

    // Remove existing event listeners to prevent duplicates
    faqQuestions.forEach((question) => {
      const newQuestion = question.cloneNode(true);
      question.parentNode.replaceChild(newQuestion, question);
    });

    // Get updated questions after cloning
    const updatedFaqQuestions = document.querySelectorAll('.faq-question');

    updatedFaqQuestions.forEach((question) => {
      question.addEventListener('click', function () {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const answer = this.nextElementSibling;

        // Close all other FAQs
        updatedFaqQuestions.forEach((otherQuestion) => {
          if (otherQuestion !== this) {
            otherQuestion.setAttribute('aria-expanded', 'false');
            otherQuestion.nextElementSibling.classList.remove('active');
          }
        });

        // Toggle current FAQ
        if (!isExpanded) {
          this.setAttribute('aria-expanded', 'true');
          answer.classList.add('active');
        } else {
          this.setAttribute('aria-expanded', 'false');
          answer.classList.remove('active');
        }
      });
    });

    // Smooth scroll for CTA buttons
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
          });
        }
      });
    });
  }

  // Initialize on DOM content loaded
  document.addEventListener('DOMContentLoaded', initFAQ);

  // Re-initialize after view transitions
  document.addEventListener('astro:after-swap', initFAQ);

  // Alternative: also handle astro:page-load for additional safety
  document.addEventListener('astro:page-load', initFAQ);
</script>
