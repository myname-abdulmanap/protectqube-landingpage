---
// AdvantagesSection.astro
---

<section class="services-section">
  <div class="container">
    <div class="services-header">
      <h2 class="animate-element fade-up">
        ProtectQube Advantages<span class="line-animated"></span>
      </h2>
      <p class="animate-element fade-up">
        Leading IoT Security solution with advanced technology to protect your digital
        infrastructure from cyber threats
      </p>
    </div>

    <div class="services-layout">
      <div class="services-grid">
        <div class="service-card animate-element fade-in-right">
          <div class="service-icon red">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>
          <div class="service-content">
            <h3>Advanced Threat Detection</h3>
            <p>
              Real-time monitoring and AI-powered threat detection for comprehensive IoT security
            </p>
          </div>
        </div>

        <div class="service-card animate-element fade-in-right">
          <div class="service-icon blue">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <div class="service-content">
            <h3>Zero Trust Architecture</h3>
            <p>Never trust, always verify approach with end-to-end encryption and authentication</p>
          </div>
        </div>

        <div class="service-card animate-element fade-in-right">
          <div class="service-icon yellow">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <div class="service-content">
            <h3>Lightning Fast Response</h3>
            <p>Instant threat response with automated incident management and rapid remediation</p>
          </div>
        </div>

        <div class="service-card animate-element fade-in-right">
          <div class="service-icon red">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <div class="service-content">
            <h3>Smart Analytics Dashboard</h3>
            <p>Comprehensive security insights with predictive analytics and detailed reporting</p>
          </div>
        </div>

        <div class="service-card animate-element fade-in-right">
          <div class="service-icon blue">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <div class="service-content">
            <h3>Scalable Architecture</h3>
            <p>
              Enterprise-grade scalability supporting millions of IoT devices with seamless
              integration
            </p>
          </div>
        </div>
      </div>

      <div class="lottie-container animate-element fade-in-left">
        <dotlottie-player
          src="https://lottie.host/22ab9698-c0a3-421f-a435-23f88fb9c743/aIuYReVX5S.lottie"
          background="transparent"
          speed="1"
          loop
          autoplay></dotlottie-player>
      </div>
    </div>
  </div>
</section>

<script src="/src/components/js/services.js"></script>

<style>
  .services-section {
    padding: 6rem 0;
    background: var(--service-container);
    position: relative;
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
  }

  .services-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .services-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--heading-color);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
  }

  .services-header h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 3px;
    background: linear-gradient(to right, #4338ca, #ec4899);
    border-radius: 3px;
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .services-header h2.animate::after {
    width: 80px;
  }

  .services-header p {
    max-width: 36rem;
    margin: 1.5rem auto 0;
    color: var(--text-secondary, #6b7280);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .services-layout {
    display: flex;
    gap: 3rem;
    align-items: center;
    justify-content: space-between;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    flex: 1;
  }

  .service-card {
    background: var(--color-card, white);
    padding: 1.75rem;
    border-radius: 1rem;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.04);
    will-change: transform;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 0;
    background: var(--icon-color, #4338ca);
    transition: height 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .service-card.card-hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .service-card.card-hover::before {
    height: 100%;
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    margin-right: 1.25rem;
    color: white;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.1);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .card-hover .service-icon {
    transform: scale(1.1);
  }

  .service-icon svg {
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.1));
    transition: transform 0.3s ease;
  }

  .card-hover .service-icon svg {
    transform: scale(1.1);
  }

  .service-icon.red {
    background: linear-gradient(135deg, #ff6b6b, #ee5253);
  }

  .service-icon.blue {
    background: linear-gradient(135deg, #48a0f9, #3b82f6);
  }

  .service-icon.yellow {
    background: linear-gradient(135deg, #feca57, #f59e0b);
  }

  .service-content {
    flex: 1;
  }

  .service-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--heading-color, #1f2937);
    margin-bottom: 0.75rem;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  .card-hover .service-content h3 {
    color: #4338ca;
    transform: translateX(5px);
  }

  .service-content p {
    color: var(--text-body, #6b7280);
    font-size: 1rem;
    line-height: 1.6;
    transition: transform 0.3s ease;
  }

  .card-hover .service-content p {
    transform: translateX(5px);
  }

  .lottie-container {
    width: 400px;
    height: 400px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    animation: float 6s ease-in-out infinite;
  }

  .lottie-container::before {
    content: '';
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0) 70%);
    z-index: -1;
    animation: pulse 3s infinite;
  }

  dotlottie-player {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 15px 15px rgba(0, 0, 0, 0.08));
  }

  /* Animation Keyframes */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.9;
    }
    100% {
      transform: scale(0.95);
      opacity: 0.7;
    }
  }

  /* Entrance Animations */
  .animate-element {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }

  .animate-element.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .fade-up {
    transform: translateY(50px);
  }

  .fade-in-right {
    transform: translateX(-50px);
  }

  .fade-in-left {
    transform: translateX(50px);
  }

  /* Staggered animations for service cards */
  .service-card:nth-child(1).animate {
    transition-delay: 0.1s;
  }
  .service-card:nth-child(2).animate {
    transition-delay: 0.2s;
  }
  .service-card:nth-child(3).animate {
    transition-delay: 0.3s;
  }
  .service-card:nth-child(4).animate {
    transition-delay: 0.4s;
  }
  .service-card:nth-child(5).animate {
    transition-delay: 0.5s;
  }

  /* Exit animation with fade-out */
  .exit {
    opacity: 0;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  /* Responsive styles */
  @media (max-width: 1100px) {
    .services-layout {
      flex-direction: column;
    }

    .lottie-container {
      order: -1;
      margin-bottom: 3rem;
      width: 350px;
      height: 350px;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .services-header h2 {
      font-size: 2rem;
    }

    .lottie-container {
      width: 300px;
      height: 300px;
    }
  }

  @media (max-width: 480px) {
    .service-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .service-icon {
      margin-right: 0;
      margin-bottom: 1rem;
    }

    .lottie-container {
      width: 250px;
      height: 250px;
    }
  }
</style>
